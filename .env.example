# Environment Configuration for NEXUS GRAPH AI

# App Settings
APP_NAME=NEXUS GRAPH AI
ENVIRONMENT=development
DEBUG=true
PORT=8080
HOST=127.0.0.1
TENANT_DEFAULT_ID=tenant_nexus_main

# Graph Database (FalkorDB)
# On Windows using WSL2 FalkorDB, set to your WSL IP (e.g., 172.17.109.154) or localhost
# FalkorDB client will auto-detect and resolve WSL IP if localhost fails
FALKORDB_HOST=172.17.109.154
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=nexus_company_graph
FALKORDB_PASSWORD=

# Relational Database (PostgreSQL / SQLite Standalone Fallback)
# Uses SQLite automatically if PostgreSQL is unreachable or running standalone
DATABASE_URL=sqlite+aiosqlite:///./nexus_metadata.db
# Example for PostgreSQL: postgresql+asyncpg://nexus:nexus_secure_password@localhost:5432/nexus_graph_ai

# Caching and Task Leases (Redis / In-Memory Standalone Fallback)
REDIS_URL=redis://localhost:6380/0

# AI Model Strategy
# Options:
#   - 'huggingface': Local CPU/CUDA inference via Hugging Face Transformers
#   - 'openai': Remote OpenAI-compatible API (OpenAI, vLLM, Ollama, LM Studio)
#   - 'vllm': vLLM high-throughput server
#   - 'mock': Deterministic mock adapter for headless CI environments
LLM_PROVIDER=huggingface
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_DEVICE=cpu
DEVICE_MAP=auto
TORCH_DTYPE=float32

# Remote OpenAI/vLLM Settings (used if LLM_PROVIDER=openai or vllm)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Secrets
SECRET_KEY=nexus_super_secret_production_key_change_in_real_env_38192849
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MCP & Actions Security Gate
REQUIRE_HUMAN_APPROVAL_FOR_ACTIONS=true
AUTO_APPROVE_READONLY=true
